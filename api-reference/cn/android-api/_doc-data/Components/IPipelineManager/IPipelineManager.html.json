elineconnectionlistener\" data-target=\"ipipelinemanager_pipelineconnectionlistener\"><span class=\"ifm-toc-kind ifm-toc-kind-class\">C</span>PipelineConnectionListener</a></li>\n          </ul>\n        </div>\n      ","buildId":"1795058050072"}