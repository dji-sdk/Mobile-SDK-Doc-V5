nager_serverstate\"><span class=\"ifm-toc-kind ifm-toc-kind-enum\">E</span>ServerState</a></li><li class=\"ifm-toc-related\"><a href=\"#isdkmanager_appversion\" data-target=\"isdkmanager_appversion\"><span class=\"ifm-toc-kind ifm-toc-kind-class\">C</span>APPVersion</a></li><li class=\"ifm-toc-related\"><a href=\"#isdkmanager_openlocation\" data-target=\"isdkmanager_openlocation\"><span class=\"ifm-toc-kind ifm-toc-kind-class\">C</span>OpenLocation</a></li>\n          </ul>\n        </div>\n      ","buildId":"1795062379137"}